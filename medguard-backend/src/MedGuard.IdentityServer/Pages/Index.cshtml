@page
@model MedGuard.IdentityServer.Pages.Home.Index
@inject IConfiguration Configuration
@{
    // App:Url = where the dashboard lives ("/" when it shares this origin, as in
    // the Docker deployment). Unset = no dashboard link (e.g. runasp.net).
    var appUrl = Configuration["App:Url"];
}

<div class="mg-page">
    <div class="mg-page-head">
        <h1>MedGuard Identity</h1>
        <p>Sign-in and token service of the MedGuard cold-chain platform · Duende IdentityServer @Model.Version</p>
    </div>

    <div class="mg-link-grid">
        @if (!string.IsNullOrWhiteSpace(appUrl))
        {
            <a class="mg-link-card mg-link-card--primary" href="@appUrl">
                <strong>Open the dashboard</strong>
                <span>Batches, live monitoring, alerts and shipments</span>
            </a>
        }
        <a class="mg-link-card" href="~/diagnostics">
            <strong>Your session</strong>
            <span>Claims and properties of the current sign-in</span>
        </a>
        <a class="mg-link-card" href="~/grants">
            <strong>Application permissions</strong>
            <span>Review or revoke the access you granted</span>
        </a>
        <a class="mg-link-card" href="~/.well-known/openid-configuration">
            <strong>Discovery document</strong>
            <span>OpenID Connect metadata, endpoints and signing keys</span>
        </a>
    </div>

    @if (Model.License != null)
    {
        <div class="card mg-license">
            <div class="card-header"><h2>License</h2></div>
            <div class="card-body">
                <dl>
                    <dt>Serial number</dt>
                    <dd>@Model.License.SerialNumber</dd>
                    <dt>Expiration</dt>
                    <dd>@Model.License.Expiration!.Value.ToLongDateString()</dd>
                </dl>
            </div>
        </div>
    }
</div>

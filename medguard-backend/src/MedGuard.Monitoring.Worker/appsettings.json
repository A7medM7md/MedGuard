{
  "ConnectionStrings": {
    "MedGuardDb": "Server=.;Database=MedGuardDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Monitoring": {
    "KafkaBootstrapServers": "localhost:9092",
    "GroupId": "monitoring",
    "InstanceId": "1",
    "MaxAttemptsForUnknownErrors": 3,
    "MaxBatchSize": 200,
    "MaxBatchWaitMs": 20
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalMs": 500,
    "BatchSize": 100,
    "ProduceTimeoutMs": 10000,
    "RetentionHours": 24
  },
  "Logging": {
    "Console": { "FormatterName": "simple", "FormatterOptions": { "SingleLine": true, "TimestampFormat": "HH:mm:ss " } },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}

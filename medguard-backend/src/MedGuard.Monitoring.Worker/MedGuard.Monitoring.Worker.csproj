<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Web SDK, not Worker SDK: the worker still has no API, but it serves
       /health/live and /health/ready so an orchestrator can restart a stuck
       instance or stop routing work to it (ADR 0010). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8f12c2cd-31ec-44eb-96ae-226188ab5922</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.15.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Polly.Core" Version="8.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MedGuard.Application\MedGuard.Application.csproj" />
    <ProjectReference Include="..\MedGuard.Infrastructure\MedGuard.Infrastructure.csproj" />
    <ProjectReference Include="..\MedGuard.Contracts\MedGuard.Contracts.csproj" />
    <ProjectReference Include="..\MedGuard.ServiceDefaults\MedGuard.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>

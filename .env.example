# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored.
# Passwords: letters, digits and - _ @ ! only (they end up in a connection string
# and in YAML interpolation, where ; = $ # and quotes would break things).

# Images: which registry/tag `docker compose pull` fetches (CI deploys set IMAGE_TAG).
REGISTRY=ghcr.io/a7medm7md
IMAGE_TAG=latest

# SQL Server "sa" password (8+ chars, upper + lower + digit + symbol).
SQL_SA_PASSWORD=Ahmed@2003

# Secret of the machine-to-machine client "medguard-m2m" (client credentials).
M2M_CLIENT_SECRET=change-me

# Optional Duende IdentityServer license key (the Community Edition is free for
# small companies). Empty = unlicensed dev/test mode, which logs a warning.
DUENDE_LICENSE_KEY=

# Public origin(s) of the app (';'-separated, no trailing slash). They become the
# Angular client's redirect URIs and CORS origins in IdentityServer; the issuers
# the API accepts are the same origins + /identity.
# Production (behind the Cloudflare Tunnel):
SPA_ORIGINS=https://medguard.dpdns.org
PUBLIC_AUTHORITY=https://medguard.dpdns.org/identity
VALID_ISSUERS=https://medguard.dpdns.org/identity
# Local run (docker compose up, then http://localhost:8088) — use these instead:
# SPA_ORIGINS=http://localhost:8088
# PUBLIC_AUTHORITY=http://localhost:8088/identity
# VALID_ISSUERS=http://localhost:8088/identity

# Cloudflare Tunnel (production only). The token is from Zero Trust ->
# Networks -> Tunnels -> <tunnel> -> install connector; the tunnel's public
# hostname must point to http://edge:80.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
# Production: COMPOSE_PROFILES=tunnel

# Host ports, loopback only.
EDGE_BIND=127.0.0.1
EDGE_PORT=8088
SQL_PORT=14330
MQTT_BIND=127.0.0.1
MQTT_PORT=1883
